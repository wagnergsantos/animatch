diff --git a/src/components/RecommendationGrid.test.jsx b/src/components/RecommendationGrid.test.jsx
index 2afea09..ff62be1 100644
--- a/src/components/RecommendationGrid.test.jsx
+++ b/src/components/RecommendationGrid.test.jsx
@@ -91,6 +91,38 @@ describe('RecommendationGrid', () => {
     const rows = screen.getAllByTestId('anime-row')
     expect(rows).toHaveLength(2)
   })
+
+  describe('progressive rendering (lote inicial)', () => {
+    const manyRecs = Array.from({ length: 40 }, (_, i) => ({
+      id: i + 1,
+      title: `Anime ${i + 1}`,
+      predictedScore: 9 - i * 0.1,
+      communityScore: 8,
+      coverImage: '',
+    }))
+
+    it('renderiza apenas os 15 primeiros itens quando a lista é maior que o lote inicial', () => {
+      render(<RecommendationGrid isLoading={false} recommendations={manyRecs} />)
+      expect(screen.getByText('Anime 1')).toBeInTheDocument()
+      expect(screen.getByText('Anime 15')).toBeInTheDocument()
+      expect(screen.queryByText('Anime 16')).not.toBeInTheDocument()
+      expect(screen.getByTestId('grid-sentinel')).toBeInTheDocument()
+    })
+
+    it('não mostra sentinela nem corta a lista quando há poucos itens', () => {
+      const fewRecs = manyRecs.slice(0, 10)
+      render(<RecommendationGrid isLoading={false} recommendations={fewRecs} />)
+      expect(screen.getByText('Anime 10')).toBeInTheDocument()
+      expect(screen.queryByTestId('grid-sentinel')).not.toBeInTheDocument()
+    })
+
+    it('mostra todos os itens em ambiente sem IntersectionObserver (jsdom)', () => {
+      // jsdom não implementa IntersectionObserver — o fallback deve revelar tudo
+      expect(typeof globalThis.IntersectionObserver).toBe('undefined')
+      render(<RecommendationGrid isLoading={false} recommendations={manyRecs} />)
+      expect(screen.getByText('Anime 40')).toBeInTheDocument()
+    })
+  })
 })
 
 
